Object.entries(SITE_OF).forEach(([id,[site,path]])=>{ const s=STEPS.find(x=>x.id===id); if(s){ s.site=site; s.path=path; } });
function siteOf(st){ return SITES[st&&st.site] || SITES.zone; }
function siteLabel(st){ const s=siteOf(st); const mock = S.course==='zone' && st.site && st.site!=='zone'; return s.ic+' '+s.n+(mock?' (체험존 모사)':''); }
function renderFrame(st){ const s=siteOf(st); const f=$('frame'); f.dataset.kind=s.kind; f.style.setProperty('--sc', s.c); $('fIco').textContent=s.ic; $('fTitle').textContent=s.n+(S.course==='zone'&&st.site&&st.site!=='zone'?' · 체험존 모사':''); $('fUrl').textContent = s.kind==='app' ? '📶 '+(st.path||'') : s.kind==='pc' ? s.url : (s.url+(st.path?'  ›  '+st.path.split(' › ').slice(-1)[0]:'')); const fs=$('fSrc'); if(fs){ const real=!!st.real || S.course==='zone'; fs.dataset.real=st.synth?'x':(real?'1':'0'); fs.textContent = st.synth ? '🧪 변조 화면(연습)' : real ? '📸 실제 화면' : '📄 매뉴얼 화면'; fs.title = st.synth ? '연습용으로 일부러 틀린 설정을 넣은 화면 — 실제 화면 아님' : real ? '실제 서비스 화면을 그대로 캡처한 보드' : '공식 매뉴얼 캡처 보드 — 실제 화면과 배치·문구가 조금 다를 수 있어요'; } $('siteChip').textContent=s.ic+' '+s.n.replace(/ \(.*\)/,''); $('siteChip').style.background=s.c; $('dPath').textContent = st.path ? s.ic+' '+s.n+' › '+st.path : ''; $('dPath').hidden=!st.path; }
function siteToast(prev, next){ const a=SITES[prev]||SITES.zone, b=SITES[next]||SITES.zone; const t=document.createElement('div'); t.className='sitetoast'; t.innerHTML=`<div class="stt">🔁 사이트 이동</div><div class="stb"><span style="--sc:${a.c}">${a.ic} ${esc(a.n)}</span><b>→</b><span style="--sc:${b.c}">${b.ic} ${esc(b.n)}</span></div><div class="sts">${b.kind==='app'?'이제 환자 스마트폰 화면입니다':b.kind==='pc'?'이제 PC 프로그램 화면입니다':'이제 '+esc(b.url)+' 화면입니다'}</div>`; $('arenaUi').appendChild(t); setTimeout(()=>t.remove(), 2600); const f=$('frame'); f.classList.remove('switch'); void f.offsetWidth; f.classList.add('switch'); SFX.pop(); }
